{
  "name": "admit-one",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:server": "NEXT_PUBLIC_BACKEND=server next dev",
    "build": "next build",
    "build:server": "NEXT_PUBLIC_BACKEND=server NEXT_DIST_DIR=.next-server next build",
    "build:razorpay": "NEXT_PUBLIC_BACKEND=server NEXT_DIST_DIR=.next-razorpay RAZORPAY_KEY_ID=rzp_test_fake0000000000 NEXT_PUBLIC_RAZORPAY_CHECKOUT_URL=http://localhost:4191/v1/checkout.js next build",
    "start": "next start",
    "prelint": "next typegen",
    "lint": "eslint",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:stories": "vitest run --project storybook",
    "test:server": "vitest run --project server",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet -o storybook-static",
    "test:e2e": "playwright test --project=chromium --project=camera",
    "test:e2e:perf": "playwright test --project=perf",
    "test:e2e:server": "playwright test --config=playwright.server.config.ts",
    "test:e2e:razorpay": "playwright test --config=playwright.razorpay.config.ts",
    "test:visual": "scripts/visual.sh",
    "lhci": "lhci autorun",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "node scripts/copy-zxing-wasm.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "barcode-detector": "^3.2.3",
    "drizzle-orm": "^0.45.4",
    "idb-keyval": "^6.3.0",
    "msw": "^3.0.3",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.90.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.6",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-storybook": "^10.6.3",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^7",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
