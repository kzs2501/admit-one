{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 4181",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:4181/",
        "http://localhost:4181/events/frontend-systems-summit",
        "http://localhost:4181/events/monsoon-strings"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 430080 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci-mobile" }
  }
}
